# Copy to .env and change the placeholders. Nothing in this file is a real secret.

# Postgres. DATABASE_URL is the owner, used by migrations, the seed command and policy
# ingest. The API logs in as claimcheck_app (APP_DATABASE_URL) and the worker as
# claimcheck_worker (WORKER_DATABASE_URL); row-level security applies to both.
POSTGRES_USER=claimcheck
POSTGRES_PASSWORD=claimcheck
POSTGRES_DB=claimcheck
# The passwords the migration gives the claimcheck_app / claimcheck_worker roles, read from the
# environment or this file by `make migrate` and by the compose migrate service alike. Keep them
# equal to the passwords in APP_DATABASE_URL and WORKER_DATABASE_URL below; docker compose
# builds its own URLs from these two.
APP_DB_PASSWORD=claimcheck_app
WORKER_DB_PASSWORD=claimcheck_worker
DATABASE_URL=postgresql+psycopg://claimcheck:claimcheck@localhost:5432/claimcheck
APP_DATABASE_URL=postgresql+psycopg://claimcheck_app:claimcheck_app@localhost:5432/claimcheck
WORKER_DATABASE_URL=postgresql+psycopg://claimcheck_worker:claimcheck_worker@localhost:5432/claimcheck

# LLM backend: anthropic | openai | ollama. Left unset, docker compose answers from the
# recorded cassettes ("replay", which exists for CI, tests and the demo), so `make demo` needs
# no model; host commands such as the evals default to ollama. Set one to use a real model:
# LLM_BACKEND=ollama
# LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=replace-me
OPENAI_API_KEY=replace-me
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_MODEL=gpt-5-mini
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=300
# Only read by docker compose: where containers reach Ollama (default: the host machine).
# COMPOSE_OLLAMA_URL=http://ollama:11434

# Replay backend (tests and CI only). REPLAY_INNER is the backend that fills cassette
# misses while REPLAY_RECORD=1.
REPLAY_DIR=evals/cassettes
REPLAY_RECORD=false
REPLAY_INNER=

STORAGE_DIR=var/storage

# HS256 signing key for API tokens. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string

# OTLP/HTTP endpoint, e.g. http://localhost:4318 for the bundled Jaeger. Empty disables tracing.
OTEL_ENDPOINT=

# Where fastembed caches the embedding model (downloaded on first use, then offline).
FASTEMBED_CACHE=var/models
